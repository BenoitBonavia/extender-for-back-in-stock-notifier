includes:
    - vendor/szepeviktor/phpstan-wordpress/extension.neon

parameters:
    level: 6
    paths:
        - extender-for-back-in-stock-notifier.php
        - uninstall.php
        - src
    excludePaths:
        # Bibliothèque tierce embarquée telle quelle.
        - lib/*
    bootstrapFiles:
        - vendor/php-stubs/woocommerce-stubs/woocommerce-stubs.php
    scanFiles:
        - vendor/php-stubs/woocommerce-stubs/woocommerce-stubs.php
        # Constantes du plugin dont PHPStan ne peut pas évaluer la valeur dans le
        # fichier principal (elles viennent d'appels de fonction WordPress). Ce
        # fichier ne peut pas être « analysé » ET « scanné » : d'où un stub à part.
        - stubs/plugin-constants.php
        # Action Scheduler est embarqué par WooCommerce, mais absent de ses stubs.
        - stubs/action-scheduler.php
        # Classes de l'extension hôte réellement appelées, toutes gardées par
        # class_exists() / method_exists() à l'exécution.
        - stubs/back-in-stock-notifier.php
    scanDirectories:
        # La bibliothèque de mise à jour est exclue de l'ANALYSE (excludePaths),
        # mais ses classes doivent rester résolvables : buildUpdateChecker()
        # renvoie une union de trois types de vérificateurs.
        - lib/plugin-update-checker/Puc
    treatPhpDocTypesAsCertain: false
    # Les constantes de l'extension hôte restent lues par constant() sous garde
    # defined(). Ses CLASSES, en revanche, sont désormais appelées — le module
    # de désabonnement emprunte son API plutôt que d'écrire le statut lui-même —
    # d'où le stub ci-dessus, préféré à un abaissement du niveau d'analyse.
